{
  "name": "vayroai",
  "version": "1.0.0",
  "private": true,
  "description": "VayroAI — Telegram AI assistant on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:reset": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "format:check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.34.0"
  }
}
